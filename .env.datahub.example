# DataHub quickstart
# Copy this file to .env.datahub before starting the local governance stack.

COMPOSE_PROFILES=quickstart
DATAHUB_VERSION=v1.4.0
UI_INGESTION_DEFAULT_CLI_VERSION=1.4.0

# Local ports
DATAHUB_FRONTEND_PORT=9002
DATAHUB_MAPPED_GMS_PORT=8080

# Local UI credentials documented by the DataHub quickstart:
# username: datahub
# password: datahub

# Replace these values in .env.datahub for a stable local installation.
# Generate each value with: openssl rand -base64 32
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=replace-with-local-signing-key
DATAHUB_TOKEN_SERVICE_SALT=replace-with-local-salt
